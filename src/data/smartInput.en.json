{
  "version": 1,
  "locale": "en",
  "note": "Pure vocabulary data for the rule-based smart-input parser. No code, no regex — safe to move to the backend and serve from an endpoint later. Matching is case-insensitive and on whole words only.",

  "intentPrefixes": [
    "please remind me to",
    "remind me to",
    "remind me",
    "i need to",
    "i have to",
    "i want to",
    "need to",
    "have to",
    "make a note to",
    "make a note",
    "add a new task to",
    "add a new task",
    "add a task to",
    "add a task",
    "create a task to",
    "create a task",
    "new task",
    "add a",
    "add an",
    "create a",
    "create an",
    "schedule a",
    "schedule an",
    "set up a",
    "set up an",
    "add",
    "create",
    "schedule",
    "todo",
    "task"
  ],

  "fillerWords": ["please", "kindly", "just", "also", "maybe", "around", "about", "approximately", "sharp", "ok", "okay", "hey", "um", "uh", "well"],

  "cancelCommandsNote": "Matched against the WHOLE utterance after normalising, never as a substring — so 'cancel the client meeting' still creates a task.",
  "cancelCommands": [
    "cancel", "cancel it", "cancel that", "cancel this",
    "close", "close it", "close this", "close the popup",
    "exit", "quit", "stop", "stop it",
    "abort", "dismiss", "discard",
    "never mind", "nevermind", "forget it", "forget that",
    "leave it", "no thanks", "not now",
    "don't add", "do not add", "dont add",
    "go back", "back"
  ],

  "priorities": {
    "URGENT": ["urgent", "urgently", "asap", "immediately", "right away", "critical", "emergency"],
    "HIGH": ["important", "high priority", "top priority", "priority", "must do"],
    "MEDIUM": ["normal priority", "medium priority"],
    "LOW": ["low priority", "whenever", "sometime", "no rush", "not urgent"]
  },

  "categories": {
    "Work": [
      "client", "meeting", "office", "project", "report", "standup", "stand up",
      "presentation", "deadline", "interview", "demo", "email", "boss", "manager",
      "team", "review", "sprint", "deploy", "release", "invoice", "proposal"
    ],
    "Personal": [
      "groceries", "grocery", "shopping", "birthday", "anniversary", "movie",
      "dinner", "lunch", "breakfast", "family", "friend", "haircut", "laundry",
      "clean", "cook", "party", "trip", "travel", "book tickets"
    ],
    "Finance": [
      "bill", "bills", "rent", "emi", "payment", "pay", "recharge", "insurance",
      "tax", "taxes", "salary", "loan", "credit card", "electricity", "subscription"
    ],
    "Health": [
      "doctor", "dentist", "medicine", "medicines", "appointment", "checkup",
      "check up", "gym", "workout", "yoga", "run", "walk", "therapy", "vaccine"
    ]
  },

  "relativeDays": {
    "today": 0,
    "tonight": 0,
    "tmrw": 1,
    "tomorrow": 1,
    "day after tomorrow": 2,
    "next week": 7
  },

  "weekdays": {
    "sunday": 0, "sun": 0,
    "monday": 1, "mon": 1,
    "tuesday": 2, "tue": 2, "tues": 2,
    "wednesday": 3, "wed": 3,
    "thursday": 4, "thu": 4, "thurs": 4,
    "friday": 5, "fri": 5,
    "saturday": 6, "sat": 6
  },

  "timeOfDay": {
    "morning": "09:00",
    "noon": "12:00",
    "afternoon": "14:00",
    "evening": "18:00",
    "tonight": "20:00",
    "night": "20:00",
    "midnight": "00:00"
  },

  "months": {
    "january": 0, "jan": 0,
    "february": 1, "feb": 1,
    "march": 2, "mar": 2,
    "april": 3, "apr": 3,
    "may": 4,
    "june": 5, "jun": 5,
    "july": 6, "jul": 6,
    "august": 7, "aug": 7,
    "september": 8, "sep": 8, "sept": 8,
    "october": 9, "oct": 9,
    "november": 10, "nov": 10,
    "december": 11, "dec": 11
  },

  "connectorWords": ["at", "on", "by", "for", "in", "the", "a", "an", "to", "this", "next"],

  "defaults": {
    "priority": "MEDIUM",
    "hourWithoutMeridiem": {
      "assumePmBelow": 8,
      "comment": "A bare hour like 'at 3' is read as 15:00; 'at 9' stays 09:00."
    }
  }
}
